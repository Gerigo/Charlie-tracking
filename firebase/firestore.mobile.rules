rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    function getFamily(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function isManager(familyId) {
      let family = getFamily(familyId);
      return isSignedIn() && (
        // New schema: managerIds array (safe get with empty default)
        request.auth.uid in family.data.get('managerIds', []) ||
        // Legacy fallback: ownerUserId for documents without managerIds
        family.data.get('ownerUserId', '') == request.auth.uid
      );
    }

    function isViewer(familyId) {
      let family = getFamily(familyId);
      return isSignedIn() && (
        request.auth.uid in family.data.get('viewerIds', [])
      );
    }

    function isFamilyMember(familyId) {
      return isManager(familyId) || isViewer(familyId);
    }

    function canWrite(familyId) { return isManager(familyId); }

    function getJoinRequest(uid) {
      return get(/databases/$(database)/documents/joinRequests/$(uid));
    }

    function hasJoinRequest(familyId, role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/joinRequests/$(request.auth.uid))
        && getJoinRequest(request.auth.uid).data.familyId == familyId
        && getJoinRequest(request.auth.uid).data.role == role;
    }

    function isLegacyEvent(data) {
      return data.get('trackerId', null) != null || data.get('userId', null) != null;
    }
    function isLegacyAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@charlie.com';
    }

    match /userProfiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid;

      allow update: if isSignedIn() && (
        // Manager peut tout modifier
        isManager(familyId) ||
        // Self-join comme viewer (ajouter seulement son propre uid à viewerIds)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerIds', 'members', 'updatedAt']) &&
          request.auth.uid in request.resource.data.viewerIds &&
          !(request.auth.uid in resource.data.get('viewerIds', [])) &&
          hasJoinRequest(familyId, 'viewer')
        ) ||
        // Self-join comme manager (ajouter seulement son propre uid à managerIds)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerIds', 'members', 'updatedAt']) &&
          request.auth.uid in request.resource.data.managerIds &&
          !(request.auth.uid in resource.data.get('managerIds', [])) &&
          hasJoinRequest(familyId, 'manager')
        )
      );
      allow delete: if isManager(familyId);
    }

    match /babies/{babyId} {
      allow read: if isSignedIn() && isFamilyMember(resource.data.familyId);
      allow create: if isSignedIn() && canWrite(request.resource.data.familyId);
      allow update, delete: if isSignedIn() && canWrite(resource.data.familyId);
    }

    match /inviteCodes/{code} {
      // get autorisé aux signed-in, list bloqué pour empêcher énumération
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['familyId', 'familyName', 'type', 'createdAt'])
        && request.resource.data.familyId is string
        && request.resource.data.familyName is string
        && request.resource.data.type in ['manager', 'viewer']
        && isManager(request.resource.data.familyId);
      allow update, delete: if isSignedIn() && isManager(resource.data.familyId);
    }

    match /joinRequests/{uid} {
      allow get, delete: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['familyId', 'role', 'code', 'updatedAt'])
        && request.resource.data.familyId is string
        && request.resource.data.role in ['manager', 'viewer']
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.code)).data.familyId == request.resource.data.familyId
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.code)).data.type == request.resource.data.role;
    }

    match /appLogs/{logId} {
      allow create: if isSignedIn();
      allow read, delete: if isSignedIn() && request.auth.token.email == 'admin@charlie.com';
    }

    match /events/{eventId} {
      allow read: if isSignedIn() && (
        (isLegacyEvent(resource.data) && isLegacyAdmin()) ||
        isFamilyMember(resource.data.familyId)
      );
      allow create: if isSignedIn() && (
        (isLegacyEvent(request.resource.data) && isLegacyAdmin()) ||
        (canWrite(request.resource.data.familyId) && request.resource.data.createdByUserId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        (isLegacyEvent(resource.data) && isLegacyAdmin()) ||
        canWrite(resource.data.familyId)
      );
      allow delete: if isSignedIn() && (
        (isLegacyEvent(resource.data) && isLegacyAdmin()) ||
        canWrite(resource.data.familyId)
      );
    }

    match /activeSessions/{sessionId} {
      allow read: if isSignedIn() && (
        resource == null ||
        (resource.data.get('trackerId', null) != null && isLegacyAdmin()) ||
        isFamilyMember(resource.data.familyId)
      );
      allow create, update, delete: if isSignedIn() && (
        (request.resource != null && request.resource.data.get('trackerId', null) != null && isLegacyAdmin()) ||
        (resource != null && resource.data.get('trackerId', null) != null && isLegacyAdmin()) ||
        (request.resource != null && canWrite(request.resource.data.familyId)) ||
        (resource != null && isManager(resource.data.familyId))
      );
    }
  }
}
