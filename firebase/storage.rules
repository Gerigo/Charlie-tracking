rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User avatars — only the user themselves can write their own photo
    match /users/{userId}/avatar {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Baby avatars — stored under the uploader's own namespace.
    // Firestore controls who is allowed to persist the resulting URL on a baby doc.
    match /users/{userId}/babies/{babyId}/avatar {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
