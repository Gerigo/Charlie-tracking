EXPO_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
EXPO_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
EXPO_PUBLIC_APP_ENV="development"

# Optional — Mistral API key for the growth-spurt LLM analysis feature.
# ⚠️ EXPO_PUBLIC_* vars are bundled into the JS and exposed publicly.
# For production, route via a Cloud Function instead. Acceptable for V1
# personal use with a usage-capped key.
EXPO_PUBLIC_MISTRAL_API_KEY=""
EXPO_PUBLIC_MISTRAL_MODEL="mistral-small-latest"

# Soft client-side cap on successful analyses per device per local-day.
# Defaults to 10 if unset. Bumps the floor for accidental over-use; not
# a security boundary (the key is in the bundle).
EXPO_PUBLIC_MISTRAL_DAILY_LIMIT="10"
