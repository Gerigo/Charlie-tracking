EXPO_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
EXPO_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
EXPO_PUBLIC_APP_ENV="development"

# ─── LLM growth-spurt analysis ────────────────────────────────────────────
# The Mistral API key now lives ONLY on the server (Vercel Edge Function).
# Set it in the Vercel dashboard as `MISTRAL_API_KEY` (no EXPO_PUBLIC_
# prefix → never bundled into the client JS).
#
# Client-side, just flip this flag to surface the "Demander une analyse"
# button. The button calls /api/growth-spurt-analysis which proxies to
# Mistral with the server-side key.
EXPO_PUBLIC_MISTRAL_ENABLED="true"

# Soft client-side cap on successful analyses per device per local-day.
# Defaults to 10 if unset. Doesn't replace server-side quotas — those
# would need Upstash KV or similar. For now, the Mistral cap on the key
# itself is the ultimate ceiling.
EXPO_PUBLIC_MISTRAL_DAILY_LIMIT="10"

# ─── Server-side env vars (set in Vercel dashboard, NOT here) ─────────────
# These are documented for reference. They MUST NOT have EXPO_PUBLIC_
# prefix — that would bundle them into the JS.
#
#   MISTRAL_API_KEY      = <your secret key>
#   MISTRAL_MODEL        = mistral-small-latest   (optional)
#   ALLOWED_ORIGINS      = https://your-domain.com,https://your-vercel-url.vercel.app
#                          (optional; localhost + VERCEL_URL are auto-allowed)
